rules_version = '2';

/* ============================================================================
   AI 레이더 자유게시판 — Firestore 보안 규칙

   Firebase 콘솔 > Firestore Database > 규칙 에 이 파일 내용을 그대로 붙여넣고
   [게시]를 누릅니다.

   기본 방침
     읽기  : 누구나 (로그인 없이 글과 답글을 다 볼 수 있어야 공유 링크가 의미가 있다)
     쓰기  : 로그인한 사람만
     수정·삭제 : 본인이 쓴 글만

   ⚠️ 이 규칙이 유일한 보안 장치입니다.
   index.html 의 Firebase config(apiKey 등)는 비밀이 아니라 프로젝트 주소에 가까워
   공개 저장소에 있어도 정상입니다. 실제로 막는 것은 여기입니다.

   ⚠️ 이 프로젝트는 회사 관리시스템과 **분리된 AI 레이더 전용 프로젝트**여야 합니다.
   공개 서비스와 사내 데이터가 한 프로젝트에 있으면 규칙 실수 한 번에 회사 자료가 샙니다.
   ============================================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- 글 · 답글 ----------------
       답글도 같은 컬렉션에 들어가고 parentId 로 구분합니다(null 이면 원글). */
    match /posts/{id} {

      allow read: if true;

      /* 본인 uid 로만 쓸 수 있고, 본문·태그 길이를 서버에서 다시 확인합니다.
         카운터는 반드시 0 에서 시작해야 합니다 — 처음부터 부풀린 값으로 만들 수 없게. */
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 2000
                    && request.resource.data.tags is list
                    && request.resource.data.tags.size() <= 3
                    && request.resource.data.replyCount == 0
                    && request.resource.data.likeCount == 0;

      /* 세 가지 경우만 허용합니다.
         1) 글쓴이 본인 — 본문·태그 수정
         2) 다른 사람의 좋아요   — likeCount 만, 정확히 ±1
         3) 다른 사람의 답글     — replyCount 만, 정확히 +1
         2·3 이 필요한 이유: 좋아요와 답글은 남의 글에 다는 것이라
         본인만 수정 가능하게 두면 카운터를 올릴 방법이 없습니다.
         두 카운터를 한 번의 update 에 같이 담으면 거부됩니다 — 코드도 따로 씁니다. */
      allow update: if request.auth != null && (
           resource.data.uid == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && (request.resource.data.likeCount == resource.data.likeCount + 1
             || request.resource.data.likeCount == resource.data.likeCount - 1))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
            && request.resource.data.replyCount == resource.data.replyCount + 1)
      );

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      /* 좋아요는 사람당 문서 하나. 문서 ID 가 곧 uid 라
         남의 좋아요를 대신 누르거나 지울 수 없습니다. */
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    /* ---------------- 태그 ----------------
       문서 ID 를 태그 이름으로 쓰기 때문에 같은 이름이 두 번 만들어지지 않습니다
       (이미 있는 이름에 쓰면 update 로 취급되고, update 는 아래에서 막혀 있습니다).
       한 번 만든 태그는 이름을 바꾸거나 지울 수 없습니다. */
    match /tags/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 20;
      allow update, delete: if false;
    }

    /* ---------------- 마감 알림 구독자 ----------------
       메인 화면에서 메일 주소만 받아 적는 곳입니다(로그인 없이 누구나 신청).

       ⚠️ 명단은 아무도 읽을 수 없습니다. read 를 열면 남의 메일 주소를 통째로
       내려받을 수 있게 됩니다 — 이 컬렉션에서 가장 중요한 한 줄입니다.
       명단을 볼 일이 있으면 Firebase 콘솔이나 관리자 SDK 로 봅니다(규칙을 우회합니다).

       문서 ID 는 메일 주소 자신입니다. 같은 사람이 두 번 신청해도 줄이 하나만
       생기고, 이미 있는 주소로 다시 쓰면 update 가 되어 아래에서 막힙니다 —
       화면은 그 거절을 "이미 등록되어 있습니다"로 안내합니다.

       받는 값은 세 가지뿐입니다. 이름·전화 같은 것을 나중에 슬쩍 끼워 넣지 못하게
       키 목록을 여기서 못박습니다. */
    match /subscribers/{email} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt','source'])
                    && request.resource.data.email is string
                    && request.resource.data.email == email
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 20;
      allow update, delete: if false;
    }

    /* ---------------- 프로필 ----------------
       공개 포트폴리오입니다(/u/{슬러그}). 문서 ID 가 곧 uid 라 남의 자리에 쓸 수 없습니다.

       ⚠️ 이 컬렉션에서 가장 중요한 것은 hasOnly 한 줄입니다.
       받는 키를 여기서 못박아 **메일 주소가 들어올 자리를 아예 없앱니다**.
       구글 로그인은 메일과 실명을 함께 주지만 우리가 쓰는 것은 uid 와 사진뿐이고,
       이름도 구글의 것 대신 직접 받은 닉네임입니다. 나중에 화면 쪽에서 실수로
       email 을 담아 보내도 이 규칙이 거부합니다.

       slug 는 만들 때 한 번 정해지고 바뀌지 않습니다 — update 가 건드릴 수 있는 키
       목록에서 빠져 있습니다. 주소가 바뀌면 본인이 알려 둔 링크가 전부 죽습니다.
       delete 도 막습니다. 프로필만 지우면 slugs 의 주소 예약이 주인 없이 남습니다. */
    match /profiles/{uid} {

      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys()
                         .hasOnly(['nick','slug','bio','link','photoURL','createdAt'])
                    && request.resource.data.nick is string
                    && request.resource.data.nick.size() >= 2
                    && request.resource.data.nick.size() <= 20
                    && request.resource.data.slug is string
                    && request.resource.data.slug.size() >= 2
                    && request.resource.data.slug.size() <= 40
                    && request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 80
                    && request.resource.data.link is string
                    && request.resource.data.link.size() <= 200
                    && (request.resource.data.link == ''
                        || request.resource.data.link.matches('^https://.*'))
                    && request.resource.data.photoURL is string
                    && request.resource.data.photoURL.size() <= 500
                    /* 만든 시각은 서버 시각이어야 합니다 — 날짜를 지어낼 수 없게 */
                    && request.resource.data.createdAt == request.time;

      /* 고칠 수 있는 것은 네 가지뿐입니다. slug·createdAt 은 물론이고
         목록에 없는 새 키(email 같은 것)를 끼워 넣는 것도 affectedKeys 에 잡혀 거부됩니다. */
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['nick','bio','link','photoURL'])
                    && request.resource.data.nick is string
                    && request.resource.data.nick.size() >= 2
                    && request.resource.data.nick.size() <= 20
                    && request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 80
                    && request.resource.data.link is string
                    && request.resource.data.link.size() <= 200
                    && (request.resource.data.link == ''
                        || request.resource.data.link.matches('^https://.*'))
                    && request.resource.data.photoURL is string
                    && request.resource.data.photoURL.size() <= 500;

      allow delete: if false;
    }

    /* ---------------- 프로필 주소 예약 ----------------
       문서 ID 가 곧 주소(/u/{슬러그})이고 값은 그 주소의 주인 uid 입니다.
       태그와 같은 방식입니다 — 이미 있는 이름에 쓰면 update 로 취급되고 update 는
       막혀 있어, 같은 주소를 두 사람이 가질 수 없습니다.
       한 번 예약한 주소는 바꾸거나 지울 수 없습니다. */
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid','createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    /* ---------------- 작품 ----------------
       유튜브·비메오 주소만 받습니다. 화면이 영상 ID 를 뽑아 주소를 다시 만들어 보내므로
       여기서는 그 두 모양만 통과시킵니다 — 도메인 이름만 보는 것보다 좁습니다.
       (youtube.com/redirect?q=... 같은 것으로 아무 데나 보내지 못합니다.)

       ⚠️ 하루 등록 상한(3건)은 여기서 막을 수 없습니다. 규칙은 "이 사람이 오늘 몇 건
       올렸나"를 셀 수 없습니다. 규칙이 할 수 있는 것은 createdAt 을 서버 시각으로
       못박아 날짜 위조를 막는 데까지이고, 세는 일은 화면(wkCountToday)이 합니다.
       상한을 진짜로 강제하려면 카운터 문서나 서버 함수가 필요합니다 — 지금은 두지 않습니다. */
    match /works/{id} {

      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.keys()
                         .hasOnly(['uid','title','url','videoId','contestSlug','createdAt','likeCount'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 60
                    && request.resource.data.url is string
                    && (request.resource.data.url
                          .matches('^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{6,20}$')
                     || request.resource.data.url
                          .matches('^https://vimeo\\.com/[0-9]{6,12}$'))
                    && request.resource.data.videoId is string
                    && request.resource.data.videoId.matches('^[A-Za-z0-9_-]{6,20}$')
                    && request.resource.data.contestSlug is string
                    && request.resource.data.contestSlug.size() <= 120
                    && request.resource.data.likeCount == 0
                    && request.resource.data.createdAt == request.time;

      /* 두 가지만 허용합니다.
         1) 올린 본인 — 제목·관련 공모전만. 주소와 영상 ID 는 바꿀 수 없습니다.
            (바꿀 수 있으면 좋아요를 모은 뒤 내용만 갈아끼우는 일이 가능해집니다.)
         2) 다른 사람의 좋아요 — likeCount 만, 정확히 ±1.
         1 에 likeCount 가 없으므로 올린 본인도 자기 숫자를 부풀릴 수 없습니다. */
      allow update: if request.auth != null && (
           (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title','contestSlug'])
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 60
            && request.resource.data.contestSlug is string
            && request.resource.data.contestSlug.size() <= 120)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && (request.resource.data.likeCount == resource.data.likeCount + 1
             || request.resource.data.likeCount == resource.data.likeCount - 1))
      );

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      /* 게시판 좋아요와 같습니다 — 문서 ID 가 곧 uid 라 남의 좋아요를 대신 누를 수 없습니다. */
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    /* 그 밖의 모든 경로는 막습니다. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
